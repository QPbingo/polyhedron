# Production relay. Supply values in your deployment secret manager.
NODE_ENV=production
BIND_HOST=0.0.0.0
PORT=3001
PUBLIC_ORIGIN=https://workbench.example.com
DATABASE_URL=postgresql://polyhedron:password@127.0.0.1:5432/polyhedron
RELAY_SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# A separately paired Mac uses HOST_CONFIG=/absolute/path/host.json.
# npm run dev explicitly provisions loopback-only development credentials instead.
